# Set the real public HTTPS origin before deployment.
PUBLIC_SITE_URL=
# Optional HTTPS enquiry service endpoint. Empty uses an explicitly labelled email draft.
PUBLIC_ENQUIRY_ENDPOINT=

# Build-time AI image generation only (scripts/generate-images.mjs). Never prefix with PUBLIC_.
OPENAI_API_KEY=
# Optional overrides; defaults live in scripts/image-gen/config.mjs.
# OPENAI_IMAGE_MODEL_FLARE=gpt-image-2.5-flare
# OPENAI_IMAGE_MODEL_SUNBURST=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY_DEFAULT=medium
# OPENAI_IMAGE_QUALITY_PREMIUM=high
