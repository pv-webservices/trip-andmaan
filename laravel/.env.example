# Trip Andaman — environment template. Copy to the server as shared/.env (outside
# the web root and outside the repository) and fill in the blanks there.
# Never commit a real .env. Generate APP_KEY on the server with:
#   php artisan key:generate --show   (then paste the value below)

APP_NAME="Trip Andaman"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tripandaman.in
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Canonical origin for canonical tags, Open Graph URLs and the sitemap.
CMS_SITE_URL=https://tripandaman.in
# Redirect every other host (e.g. www.tripandaman.in) here. Leave empty locally.
CMS_CANONICAL_HOST=tripandaman.in
# Guest page cache (file cache). Publishing invalidates it immediately.
CMS_PAGE_CACHE=true
CMS_PAGE_CACHE_TTL=3600
# Upload limits in MB. PHP's upload_max_filesize and post_max_size must be larger.
CMS_IMAGE_MAX_MB=15
CMS_VIDEO_MAX_MB=60
CMS_DOCUMENT_MAX_MB=15
# Only behind a CDN/proxy that overwrites X-Forwarded-* headers (comma-separated IPs or *).
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Hostinger MySQL/MariaDB on the same server (hPanel › Databases).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# No e-mail is sent by the application. Admin passwords are reset over SSH
# with `php artisan cms:reset-password <email>`.
MAIL_MAILER=log
