<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Never execute scripts from uploaded media (defence in depth: uploads are
    # stored with fixed image/video/PDF extensions and random names).
    RewriteRule ^storage/.*\.(php\d?|phtml|phar|pl|py|cgi|sh|shtml|html?|svg)$ - [F,NC,L]

    # Page URLs keep their trailing slash (the application adds it when missing),
    # so Laravel's default "remove trailing slash" rule is intentionally absent.

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Hashed build assets never change.
    <If "%{REQUEST_URI} =~ m#^/build/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    # Uploaded media and brand images: a week, then revalidate.
    <If "%{REQUEST_URI} =~ m#^/(storage|images)/#">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
        Header set X-Content-Type-Options "nosniff"
    </If>
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType video/mp4 .mp4
    AddType video/webm .webm
    AddType application/manifest+json .webmanifest
</IfModule>
