---
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/manrope/800.css';
import '@fontsource/caveat/500.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import '../styles/global.css';
// Preload only the two fonts used above the fold (body text and headings).
import bodyFont from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';
import headingFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-700-normal.woff2?url';
import {
  enquiryText,
  navigation,
  site,
  SITE_URL,
  whatsappLink,
} from '../data/site';
import ContactDetails from '../components/ContactDetails.astro';
import Icon from '../components/Icon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import { destinations } from '../data/destinations';
import { jsonLd, organizationId, websiteId } from '../data/seo';
interface Props {
  title: string;
  description: string;
  /** Utility pages (404, credits): noindex, follow and no canonical. */
  noindex?: boolean;
  /** What the visitor is asking about, used in prefilled WhatsApp messages. */
  enquirySubject?: string;
  /** Extra JSON-LD nodes for this page (FAQPage, BreadcrumbList, …). */
  schema?: Record<string, unknown>[];
}
const {
  title,
  description,
  noindex = false,
  enquirySubject,
  schema = [],
} = Astro.props;
const path = Astro.url.pathname;
// "<title> | Trip Andaman", dropping the suffix when it would pass ~65 characters.
const MAX_TITLE = 65;
const branded = `${title} | Trip Andaman`;
const fullTitle =
  /trip andaman/i.test(title) || branded.length > MAX_TITLE ? title : branded;
const canonical = new URL(path, SITE_URL).href;
const ogImage = new URL('/images/brand/og-image-1200x630.jpg', SITE_URL).href;
// Default WhatsApp message names the site section, e.g. "from your Gallery page".
const section = navigation.find(
  ([, href]) => href !== '/' && path.startsWith(href),
)?.[0];
const pageWhatsapp = whatsappLink(
  enquiryText(
    enquirySubject ??
      (section
        ? `an Andaman trip (from your ${section} page)`
        : 'an Andaman trip'),
  ),
);
const active = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
const graph = [
  {
    '@type': 'TravelAgency',
    '@id': organizationId,
    name: site.name,
    url: `${SITE_URL}/`,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/brand/logo-800x221.png', SITE_URL).href,
      width: 800,
      height: 221,
    },
    image: ogImage,
    telephone: site.tel,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Haddo',
      addressLocality: 'Sri Vijaya Puram',
      addressRegion: 'Andaman and Nicobar Islands',
      postalCode: '744102',
      addressCountry: 'IN',
    },
    areaServed: 'Andaman and Nicobar Islands',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: site.tel,
      contactType: 'customer service',
    },
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: `${SITE_URL}/`,
    name: site.name,
    inLanguage: 'en-IN',
    publisher: { '@id': organizationId },
  },
  ...schema,
];
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c2740" />
    <meta
      name="robots"
      content={
        noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'
      }
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Turquoise lagoon and white sand on Havelock Island, Andaman"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href={bodyFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={headingFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={jsonLd(graph)} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="header-bar">
        <a class="brand" href="/" aria-label="Trip Andaman home">
          <img
            src="/images/brand/logo-light-400.webp"
            srcset="/images/brand/logo-light-240.webp 240w, /images/brand/logo-light-400.webp 400w"
            sizes="200px"
            width="400"
            height="111"
            alt="Trip Andaman"
          />
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map(([label, href]) => (
            <a href={href} aria-current={active(href) ? 'page' : undefined}>
              {label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <a class="header-call" href={`tel:${site.tel}`}>
            <span>
              <Icon name="phone" size={17} />
            </span>
            <span>
              <small>Call us</small>
              {site.phone}
            </span>
          </a>
          <a
            class="btn btn-sun on-light btn-sm header-cta"
            href="/tour-packages/customized-trip/"
          >
            Plan My Trip <Icon size={16} />
          </a>
          <button
            class="menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Open navigation"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </header>
    <dialog id="mobile-menu" class="mobile-menu" aria-label="Navigation">
      <div class="mobile-menu-top">
        <img
          src="/images/brand/logo-dark-400.webp"
          width="400"
          height="111"
          alt="Trip Andaman"
          loading="lazy"
        />
        <button class="menu-close icon-button" aria-label="Close navigation">
          <Icon name="close" size={20} />
        </button>
      </div>
      <nav aria-label="Mobile navigation">
        {navigation.map(([label, href], i) => (
          <a href={href} aria-current={active(href) ? 'page' : undefined}>
            <small>0{i + 1}</small>
            {label}
            <Icon name="arrow-up-right" size={18} />
          </a>
        ))}
      </nav>
      <div class="mobile-menu-foot">
        <a class="btn btn-sun" href="/tour-packages/customized-trip/">
          Plan My Trip <Icon size={18} />
        </a>
        <a class="btn btn-glass" href={`tel:${site.tel}`}>
          <Icon name="phone" size={18} /> Call {site.phone}
        </a>
        <p>Your next island story starts here.</p>
      </div>
    </dialog>
    <noscript>
      <nav class="no-js-nav" aria-label="Site navigation">
        {navigation.map(([label, href]) => (
          <a href={href}>{label}</a>
        ))}
      </nav>
    </noscript>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <a href="/" aria-label="Trip Andaman home">
            <img
              src="/images/brand/logo-dark-400.webp"
              width="400"
              height="111"
              alt="Trip Andaman"
              loading="lazy"
            />
          </a>
          <p>
            A travel and tourism business based in Haddo, Sri Vijaya Puram —
            helping you discover the beaches, reefs, heritage and island nature
            of Andaman.
          </p>
          <span class="script">Discover · Explore · Experience</span>
        </div>
        <div>
          <h2>Explore</h2>
          <ul>
            {navigation.slice(1).map(([label, href]) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2>The islands</h2>
          <ul>
            {destinations.map((d) => (
              <li>
                <a href={`/destinations/${d.slug}/`}>{d.name}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="on-dark">
          <h2>Get in touch</h2>
          <ContactDetails />
        </div>
      </div>
      <div class="footer-bottom">
        <div class="wrap">
          <p>© {new Date().getFullYear()} Trip Andaman. All rights reserved.</p>
          <nav aria-label="Legal and information">
            <a href="/privacy/">Privacy & enquiries</a>
            <a href="/travel-information/">Travel information</a>
            <a href="/image-credits/">Photo credits</a>
          </nav>
        </div>
      </div>
    </footer>
    <WhatsAppWidget href={pageWhatsapp} />
    <nav class="quick-actions" aria-label="Quick contact">
      <a class="btn btn-glass" href={`tel:${site.tel}`}>
        <Icon name="phone" size={17} /> Call
      </a>
      <a
        class="btn btn-whatsapp"
        href={pageWhatsapp}
        target="_blank"
        rel="noopener noreferrer"
      >
        <WhatsAppIcon size={18} /> WhatsApp
      </a>
      <a class="btn btn-sun" href="/tour-packages/customized-trip/">
        Plan My Trip
      </a>
    </nav>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
