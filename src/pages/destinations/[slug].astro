---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Picture from '../../components/Picture.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import EnquiryBanner from '../../components/EnquiryBanner.astro';
import { destinations } from '../../data/destinations';
import { site } from '../../data/site';
export function getStaticPaths() {
  return destinations.map((destination) => ({
    params: { slug: destination.slug },
    props: { destination },
  }));
}
const { destination: d } = Astro.props;
// A second, different photograph where one exists for the island.
const secondary: Record<
  string,
  { name: string; alt: string; portrait?: boolean }
> = {
  'havelock-island': {
    name: 'hero',
    alt: 'Driftwood on a sandy lagoon, Havelock Island',
  },
  'neil-island': {
    name: 'client-neil',
    alt: 'Travellers at the natural rock bridge on Neil Island — supplied photograph',
    portrait: true,
  },
};
const extra = secondary[d.slug];
---

<BaseLayout
  title={`${d.name} — ${d.official} Travel Guide`}
  description={`Discover ${d.name} (${d.official}). ${d.intro} Explore destination highlights and contact Trip Andaman to discuss your visit.`}
>
  <PageHero
    title={d.name}
    eyebrow={d.official}
    description={`${d.short} ${d.intro}`}
    image={d.image}
    alt={`${d.name} scenery`}
    crumbs={[['Destinations', '/destinations/']]}
  />
  <section class="section">
    <div class="wrap detail-grid">
      <div>
        <div data-reveal>
          <p class="eyebrow">Get to know the island</p>
          <h2 style="font-size:var(--fs-h2)">
            A place to <span class="accent">discover</span>
          </h2>
          <p class="lead" style="margin-top:20px">
            {d.text}
          </p>
        </div>
        {extra && (
          <div
            class:list={['media-frame', { portrait: extra.portrait }]}
            data-reveal
          >
            <Picture
              name={extra.name}
              alt={extra.alt}
              sizes="(max-width: 1024px) 100vw, 60vw"
            />
          </div>
        )}
        <div data-reveal style="margin-top:40px">
          <h2 style="font-size:clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem)">
            On your <span class="accent">radar</span>
          </h2>
          <ul class="highlight-cards">
            {d.highlights.map((h) => (
              <li>
                <Icon name="check" size={24} />
                {h}
              </li>
            ))}
          </ul>
        </div>
        <div class="notice" style="margin-top:36px" data-reveal>
          <Icon name="compass" size={22} />
          <p>
            <strong>Before you go.</strong> {d.note} Share your dates and any
            specific interests when you enquire, and confirm the route, visiting
            arrangements, charges and terms before booking.
          </p>
        </div>
        <p class="source-link">
          Destination reference:{' '}
          <a href={d.source} target="_blank" rel="noopener noreferrer">
            Official tourism information ↗
          </a>
          . Check current local notices before travel.
        </p>
      </div>
      <aside class="info-panel">
        <p class="eyebrow">Make room for the islands</p>
        <h2>Picture yourself here?</h2>
        <p>
          Tell us when you’re travelling, who’s coming along and what you’d love
          to experience on {d.name}.
        </p>
        <a
          class="btn btn-sun"
          href={`/tour-packages/customized-trip/?interest=${encodeURIComponent(d.name)}`}
        >
          Plan a Trip Here <Icon size={18} />
        </a>
        <div class="divider"></div>
        <a class="call" href={`tel:${site.tel}`}>
          <span>
            <Icon name="phone" size={18} />
          </span>
          {site.phone}
        </a>
        <a class="text-link" href="/destinations/">
          Explore other destinations <Icon size={16} />
        </a>
      </aside>
    </div>
  </section>
  <section class="section bg-mist">
    <div class="wrap">
      <SectionHeading
        eyebrow="Keep exploring"
        title="More island"
        accent="inspiration"
        href="/destinations/"
        label="All Destinations"
      />
      <div class="card-grid-3">
        {destinations
          .filter((other) => other.slug !== d.slug)
          .slice(0, 3)
          .map((other, i) => (
            <DestinationCard destination={other} index={i} />
          ))}
      </div>
    </div>
  </section>
  <EnquiryBanner />
</BaseLayout>
