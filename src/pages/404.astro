---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { enquiryText, navigation, site, whatsappLink } from '../data/site';
const whatsapp = whatsappLink(
  enquiryText('an Andaman trip (I reached a missing page on your website)'),
);
---

<BaseLayout
  title="Page Not Found"
  description="This page could not be found. Return to Trip Andaman's home page, tour packages or destinations, or contact us on WhatsApp or phone."
  noindex
>
  <section class="not-found">
    <Picture name="neil" alt="" eager sizes="100vw" />
    <div>
      <p class="eyebrow" style="color:var(--sun)">
        A little off the island trail
      </p>
      <p class="error-number">404</p>
      <h1>Let’s get you back to paradise.</h1>
      <p>
        We couldn’t find this page. It may have moved, or the link may be
        mistyped. Try one of these instead:
      </p>
      <nav aria-label="Helpful links" class="not-found-links">
        <ul>
          {navigation.map(([label, href]) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="btn-row">
        <a class="btn btn-sun" href="/">
          Back to Home <Icon size={18} />
        </a>
        <a
          class="btn btn-whatsapp"
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
        >
          <WhatsAppIcon size={18} /> WhatsApp us
        </a>
        <a class="btn btn-glass" href={`tel:${site.tel}`}>
          <Icon name="phone" size={18} /> Call {site.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
