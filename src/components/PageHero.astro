---
import Picture from './Picture.astro';
interface Props {
  title: string;
  eyebrow: string;
  description: string;
  image?: string;
  alt?: string;
  crumbs?: [string, string][];
}
const {
  title,
  eyebrow,
  description,
  image = 'hero',
  alt = '',
  crumbs = [],
} = Astro.props;
---

<section class="page-hero">
  <Picture name={image} alt={alt} eager sizes="100vw" />
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      {crumbs.map(([label, href]) => (
        <>
          <span aria-hidden="true">/</span>
          <a href={href}>{label}</a>
        </>
      ))}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <slot />
  </div>
</section>
