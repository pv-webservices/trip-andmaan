---
import Picture from './Picture.astro';
import Icon from './Icon.astro';
import { largestImage } from '../data/images';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const images = [
  {
    image: 'hero',
    title: 'Sandy lagoon, Havelock Island',
    category: 'Beaches',
  },
  { image: 'sunset', title: 'Evening at Elephant Beach', category: 'Beaches' },
  {
    image: 'underwater',
    title: 'Beneath the surface — supplied travel film',
    category: 'Underwater',
  },
  {
    image: 'neil',
    title: 'Coastal scenery, Shaheed Dweep',
    category: 'Islands',
  },
  { image: 'north-bay', title: 'North Bay lighthouse', category: 'Islands' },
  {
    image: 'ross',
    title: 'Historic remains on Ross Island',
    category: 'Heritage',
  },
  {
    image: 'baratang',
    title: 'Limestone formations, Baratang',
    category: 'Nature',
  },
  {
    image: 'bridge',
    title: 'Rocky coastline, Shaheed Dweep',
    category: 'Nature',
  },
  {
    image: 'client-kayak',
    title: 'A moment on the water — supplied photograph',
    category: 'Travel moments',
  },
  {
    image: 'client-neil',
    title: 'Natural bridge visit — supplied photograph',
    category: 'Travel moments',
  },
  {
    image: 'client-arrival',
    title: 'A travel group on arrival — supplied photograph',
    category: 'Travel moments',
  },
  {
    image: 'cellular-jail-wing',
    title: 'A wing of the Cellular Jail — supplied photograph',
    category: 'Heritage',
  },
  {
    image: 'cellular-jail-corridor',
    title: 'Sunlit corridor of cells, Cellular Jail — supplied photograph',
    category: 'Heritage',
  },
  {
    image: 'cellular-jail-view',
    title: 'Sea view from the Cellular Jail tower — supplied photograph',
    category: 'Heritage',
  },
  {
    image: 'resort-palms',
    title: 'Palm-fringed shore beside a resort — supplied photograph',
    category: 'Beaches',
  },
  {
    image: 'neil-reef-flats',
    title: 'Reef flats at low tide — supplied photograph',
    category: 'Nature',
  },
  {
    image: 'coastal-rocks',
    title: 'Forest-backed rocky coast — supplied photograph',
    category: 'Nature',
  },
  {
    image: 'client-group-beach',
    title: 'A beach day with friends — supplied photograph',
    category: 'Travel moments',
  },
  {
    image: 'client-airport-welcome',
    title: 'Garland welcome at Port Blair airport — supplied photograph',
    category: 'Travel moments',
  },
  {
    image: 'client-jetty-group',
    title: 'Ready to board the island cruise — supplied photograph',
    category: 'Travel moments',
  },
  {
    image: 'client-reef-shore',
    title: 'Exploring the shore at low tide — supplied photograph',
    category: 'Travel moments',
  },
  {
    image: 'client-rocky-cove',
    title: 'A rest on the rocks by the sea — supplied photograph',
    category: 'Travel moments',
  },
  {
    image: 'client-lagoon',
    title: 'Wading in a shallow lagoon — supplied photograph',
    category: 'Travel moments',
  },
  {
    image: 'client-boat-ride',
    title: 'Life jackets on for the boat ride — supplied photograph',
    category: 'Travel moments',
  },
  {
    image: 'client-beach-huts',
    title: 'Under the beach huts — supplied photograph',
    category: 'Travel moments',
  },
  {
    image: 'handicraft-elephant',
    title: 'Carved wooden elephant, local handicraft — supplied photograph',
    category: 'Shopping',
  },
  {
    image: 'handicraft-butterfly',
    title: 'Wooden butterfly wall art, local handicraft — supplied photograph',
    category: 'Shopping',
  },
];
const shown = compact
  ? [
      'hero',
      'cellular-jail-view',
      'bridge',
      'client-group-beach',
      'ross',
      'neil-reef-flats',
    ].map((name) => images.find((i) => i.image === name)!)
  : images;
---

{!compact && (
  <div class="gallery-filters" aria-label="Filter gallery">
    {['All', ...new Set(images.map((i) => i.category))].map((category, i) => (
      <button
        type="button"
        class:list={['filter-button', { 'is-active': i === 0 }]}
        aria-pressed={i === 0}
        data-filter={category}
      >
        {category}
      </button>
    ))}
  </div>
)}
<div class:list={['gallery-grid', { compact }]}>
  {shown.map((i) => (
    <figure data-category={i.category}>
      <a
        class="gallery-item"
        href={largestImage(i.image)}
        data-gallery
        data-caption={i.title}
      >
        <Picture
          name={i.image}
          alt={i.title}
          sizes="(max-width: 760px) 50vw, 33vw"
        />
        <span class="gallery-hover" aria-hidden="true">
          <span>{i.title}</span>
          <Icon name="arrow-up-right" size={18} />
        </span>
      </a>
      {!compact && <figcaption>{i.title}</figcaption>}
    </figure>
  ))}
</div>
<dialog class="lightbox" aria-label="Photo gallery viewer">
  <div class="lightbox-top">
    <p class="lightbox-counter" aria-live="polite"></p>
    <button
      class="icon-button"
      data-gallery-close
      aria-label="Close photo viewer"
    >
      <Icon name="close" size={20} />
    </button>
  </div>
  <div class="lightbox-stage">
    <button
      class="icon-button"
      data-gallery-prev
      aria-label="Previous photograph"
    >
      <Icon name="arrow-left" size={20} />
    </button>
    <img
      src={largestImage('hero')}
      alt=""
      width="1600"
      height="1200"
      loading="lazy"
      decoding="async"
    />
    <button class="icon-button" data-gallery-next aria-label="Next photograph">
      <Icon size={20} />
    </button>
  </div>
  <div class="lightbox-nav-mobile">
    <button
      class="icon-button"
      data-gallery-prev
      aria-label="Previous photograph"
    >
      <Icon name="arrow-left" size={20} />
    </button>
    <button class="icon-button" data-gallery-next aria-label="Next photograph">
      <Icon size={20} />
    </button>
  </div>
  <p class="lightbox-caption" aria-live="polite"></p>
</dialog>
