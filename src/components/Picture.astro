---
import { imageInfo, imageSrc } from '../data/images';
interface Props {
  name: string;
  alt: string;
  class?: string;
  eager?: boolean;
  sizes?: string;
}
const {
  name,
  alt,
  class: cls,
  eager = false,
  sizes = '(max-width: 700px) 100vw, 50vw',
} = Astro.props;
const info = imageInfo(name);
const widths = info.widths;
const fallback = widths.find((w) => w >= 1200) ?? widths[widths.length - 1];
---

<img
  class={cls}
  src={imageSrc(name, fallback)}
  srcset={widths.map((w) => `${imageSrc(name, w)} ${w}w`).join(', ')}
  sizes={sizes}
  alt={alt}
  width={info.width}
  height={info.height}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : 'auto'}
/>
