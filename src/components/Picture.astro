---
import { imageSrc, imageWidths } from '../data/images';
interface Props {
  name: string;
  alt: string;
  class?: string;
  eager?: boolean;
  sizes?: string;
  width?: number;
  height?: number;
}
const {
  name,
  alt,
  class: cls,
  eager = false,
  sizes = '(max-width: 700px) 100vw, 50vw',
  width = 1200,
  height = 800,
} = Astro.props;
const widths = imageWidths(name);
const fallback = widths.find((w) => w >= 1200) ?? widths[widths.length - 1];
---

<img
  class={cls}
  src={imageSrc(name, fallback)}
  srcset={widths.map((w) => `${imageSrc(name, w)} ${w}w`).join(', ')}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : 'auto'}
/>
