---
// WhatsApp message composer. It never submits data anywhere: on a valid
// submit it builds a wa.me link and the visitor decides whether to press
// Send inside WhatsApp. Validation lives in src/scripts/enquiry.ts.
import { enquiryText, site, whatsappLink, WHATSAPP_NUMBER } from '../data/site';
import Icon from './Icon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
interface Props {
  /** Page context added to the WhatsApp message, e.g. "Contact page". */
  source: string;
}
const { source } = Astro.props;
const directLink = whatsappLink(
  enquiryText(`an Andaman trip (from your ${source})`),
);
const fields = [
  'full-name',
  'mobile',
  'travel-date',
  'travellers',
  'interest',
  'message',
  'consent',
] as const;
const errorId = (id: (typeof fields)[number]) => `${id}-error`;
---

<div class="enquiry-form">
  <h2>Tell us about your dream trip</h2>
  <p>
    Fill in a few details and we will turn them into a WhatsApp message for you
    to review and send to {site.phone}.
  </p>
  <noscript>
    <p class="form-fallback">
      This form needs JavaScript to prepare your message. You can still{' '}
      <a href={directLink} target="_blank" rel="noopener noreferrer">
        chat with us on WhatsApp
      </a>{' '}
      or <a href={`tel:${site.tel}`}>call {site.phone}</a>.
    </p>
  </noscript>
  <!-- method="dialog": outside a <dialog> a native submit does nothing, so the
       details can never be sent or put in the URL, even before JS loads. -->
  <form
    method="dialog"
    class="whatsapp-composer needs-js"
    data-whatsapp={WHATSAPP_NUMBER}
    data-source={source}
    novalidate
    aria-describedby="composer-summary"
  >
    <div
      id="composer-summary"
      class="form-summary"
      role="alert"
      tabindex="-1"
      hidden
    ></div>
    <div class="form-grid">
      <div class="field">
        <label for="full-name">Full name</label>
        <input
          id="full-name"
          name="fullName"
          autocomplete="name"
          required
          minlength="2"
          maxlength="100"
        />
        <p class="field-error" id={errorId('full-name')} hidden></p>
      </div>
      <div class="field">
        <label for="mobile">
          Mobile number <span>(with country code if outside India)</span>
        </label>
        <input
          id="mobile"
          name="mobile"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          required
          maxlength="25"
          placeholder="+91 98765 43210"
        />
        <p class="field-error" id={errorId('mobile')} hidden></p>
      </div>
      <div class="field">
        <label for="travel-date">
          Travel date <span>(optional)</span>
        </label>
        <input id="travel-date" name="travelDate" type="date" />
        <p class="field-error" id={errorId('travel-date')} hidden></p>
      </div>
      <div class="field">
        <label for="travellers">
          Number of travellers <span>(optional)</span>
        </label>
        <input
          id="travellers"
          name="travellers"
          type="number"
          min="1"
          max="100"
          inputmode="numeric"
        />
        <p class="field-error" id={errorId('travellers')} hidden></p>
      </div>
      <div class="field full">
        <label for="interest">
          Destination, package or interest <span>(optional)</span>
        </label>
        <input
          id="interest"
          name="interest"
          maxlength="180"
          placeholder="An island, an experience, a little of everything…"
        />
        <p class="field-error" id={errorId('interest')} hidden></p>
      </div>
      <div class="field full">
        <label for="message">What do you have in mind?</label>
        <textarea
          id="message"
          name="message"
          required
          minlength="10"
          maxlength="1000"
          rows="4"
          placeholder="Tell us about your group, preferred pace and any places on your wish list."
        ></textarea>
        <p class="field-error" id={errorId('message')} hidden></p>
      </div>
    </div>
    <div class="consent-field">
      <label class="consent">
        <input
          id="consent"
          name="consent"
          type="checkbox"
          value="agreed"
          required
        />
        <span>
          I understand this opens WhatsApp (operated by Meta) with my details in
          a message, and nothing is sent until I press Send. Read{' '}
          <a href="/privacy/">privacy & enquiries</a>.
        </span>
      </label>
      <p class="field-error" id={errorId('consent')} hidden></p>
    </div>
    <button class="btn btn-whatsapp" type="submit">
      <WhatsAppIcon size={20} /> Open WhatsApp with my enquiry
    </button>
    <div class="composer-result" role="status" aria-live="polite">
      <p class="form-status"></p>
      <div class="composer-actions" hidden>
        <a
          class="btn btn-ghost on-light"
          data-composer-link
          href={directLink}
          target="_blank"
          rel="noopener noreferrer"
        >
          <WhatsAppIcon size={18} /> Open WhatsApp again
        </a>
        <a class="btn btn-ghost on-light" href={`tel:${site.tel}`}>
          <Icon name="phone" size={18} /> Call {site.phone}
        </a>
      </div>
    </div>
  </form>
  <p class="form-note">
    Prefer to skip the form?{' '}
    <a href={directLink} target="_blank" rel="noopener noreferrer">
      Chat on WhatsApp
    </a>{' '}
    or <a href={`tel:${site.tel}`}>call {site.phone}</a>. Please do not share
    passport, payment or other sensitive details.
  </p>
</div>
